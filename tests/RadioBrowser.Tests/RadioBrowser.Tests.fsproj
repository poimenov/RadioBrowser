<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Extensions\FunBlazorTestExtensions.fs" />
    <Compile Include="Helpers\TestData.fs" />
    <Compile Include="Fixtures\TestFixtures.fs" />
    <Compile Include="Fixtures\MockServices.fs" />
    <Compile Include="Unit\AppSettingsTests.fs" />
    <Compile Include="Unit\AppTests.fs" />
    <Compile Include="Unit\Services\PlatformServiceTests.fs" />
    <Compile Include="Unit\Services\ProcessServiceTests.fs" />
    <Compile Include="Unit\Services\LinkOpeningServiceTests.fs" />
    <Compile Include="Unit\Services\ApiUrlProviderTests.fs" />
    <Compile Include="Unit\Services\StationsServiceTests.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FsUnit.xUnit" Version="6.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.15" />
    <PackageReference Include="bunit" Version="2.15.2" />
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="AngleSharp" Version="1.10.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\RadioBrowser\RadioBrowser.fsproj" />
  </ItemGroup>
</Project>